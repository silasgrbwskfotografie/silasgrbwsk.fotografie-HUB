# Kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env
# Die .env kommt nie ins Repository.

# Öffentliche Adresse des Studio-Tools, ohne https://.
# Links werden immer aus diesem Wert gebaut, nie aus dem Host-Header.
DOMAIN=hub.silasgrbwskfotografie.de

# Erster Admin-Zugang (wird nur angelegt, solange es noch keinen Benutzer gibt).
# Passwort: mindestens 10 Zeichen.
STUDIO_ADMIN_USER=silas
STUDIO_ADMIN_PASSWORD=

# Auf 1 setzen, um das Passwort von STUDIO_ADMIN_USER beim nächsten Start zurückzusetzen
# (danach wieder auf 0 stellen)
STUDIO_RESET_PASSWORD=0
